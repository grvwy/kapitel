# The host directory containing your books. It is always mounted read-only.
KAPITEL_LIBRARY_PATH=./library
# Local development; use your HTTPS origin for remote access.
KAPITEL_PUBLIC_URL=http://localhost:8080
# Optional operational traces, off by default. Set BOTH to enable OTLP/HTTP.
KAPITEL_TELEMETRY_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector.example.org:4318
# Optional authentication: comma-separated key=percent-encoded-value pairs.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20your-token
